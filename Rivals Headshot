local Camera = workspace.CurrentCamera
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local RunService = game:GetService("RunService")

local lockEnabled = false
local fovRadius = 300
local isMinimized = false

FOVSlider.FocusLost:Connect(function()
    local num = tonumber(FOVSlider.Text)
    if num then
        fovRadius = math.clamp(num, 30, 999)
        FOVSlider.Text = tostring(fovRadius)
    else
        FOVSlider.Text = tostring(fovRadius)
    end
end)

ToggleBtn.MouseButton1Click:Connect(function()
    lockEnabled = not lockEnabled
    if lockEnabled then
        ToggleBtn.Text = "Head Lock: ON"
        ToggleBtn.TextColor3 = Color3.fromRGB(0, 255, 0)
    else
        ToggleBtn.Text = "Head Lock: OFF"
        ToggleBtn.TextColor3 = Color3.fromRGB(255, 0, 0)
    end
end)

MinMaxBtn.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    if isMinimized then
        ToggleBtn.Visible = false
        FOVSlider.Visible = false
        MainFrame.Size = UDim2.new(0, 200, 0, 30)
        MinMaxBtn.Text = "+"
    else
        ToggleBtn.Visible = true
        FOVSlider.Visible = true
        MainFrame.Size = UDim2.new(0, 200, 0, 120)
        MinMaxBtn.Text = "-"
    end
end)

local function getClosestPlayer()
    local closestTarget = nil
    local maxDistance = fovRadius
    local mousePosition = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local head = player.Character:FindFirstChild("Head")
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            
            if head and humanoid and humanoid.Health > 0 then
                if player.Team ~= LocalPlayer.Team or player.Team == nil then
                    local screenPosition, onScreen = Camera:WorldToViewportPoint(head.Position)
                    
                    if onScreen then
                        local targetDistance = (Vector2.new(screenPosition.X, screenPosition.Y) - mousePosition).Magnitude
                        if targetDistance < maxDistance then
                            maxDistance = targetDistance
                            closestTarget = head
                        end
                    end
                end
            end
        end
    end
    return closestTarget
end

RunService.RenderStepped:Connect(function()
    local hue = tick() % 5 / 5
    Title.TextColor3 = Color3.fromHSV(hue, 1, 1)

    if lockEnabled then
        local target = getClosestPlayer()
        if target then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Position)
        end
    end
end)
